# .env.example — 필요한 환경변수 샘플
# 실제 사용 시 .env 파일을 생성하고 아래 값들을 교체하세요.
# .env는 Git에 커밋하지 마세요.

# === 비전 LLM API 설정 ===
# VISION_PROVIDER: "mock"(기본) | "claude"(Anthropic Claude) | "gemini"(Google Gemini) | "external"(기타)
VISION_PROVIDER=claude
VISION_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...   ← 실제 키는 절대 이 파일에 넣지 마세요. .env 에만 설정하세요.
VISION_DRY_RUN=false

# --- Gemini (Google) 사용 시 ---
# 1. aistudio.google.com/app/apikey 에서 API 키 발급 (AIzaSy... 형태)
# 2. 아래 3줄의 주석을 해제하고 실제 키를 .env 에 설정하세요
# 3. Gemini는 VISION_DRY_RUN 이 적용되지 않습니다 — 키가 있으면 항상 실호출합니다
# 4. 클립(mp4, 최대 12초)을 Files API로 업로드 후 분석 → 즉시 삭제 (원본 영상 미전송)
# VISION_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy...   ← 실제 키는 .env 에만, 이 파일에 넣지 마세요
# GEMINI_MODEL=gemini-1.5-flash   # gemini-1.5-pro / gemini-2.0-flash 도 가능

# --- Claude (Anthropic) 사용 시 ---
# ANTHROPIC_API_KEY: Claude 전용. VISION_API_KEY 없을 때 자동 폴백으로 사용됩니다.
# 실제 .env에만 설정하고 Git에 커밋하지 마세요
# ANTHROPIC_API_KEY=sk-ant-...

# --- 기타 외부 제공자 사용 시 ---
# VISION_PROVIDER=external
# VISION_MODEL=gpt-4o
# VISION_API_KEY=your_api_key_here

# VISION_DRY_RUN: true이면 payload 검증만 하고 실제 외부 호출을 하지 않습니다 (기본: true, Gemini 제외)
# VISION_DRY_RUN=true

# 프레임 수 / 크기 상한
VISION_MAX_FRAMES_PER_SEGMENT=4
VISION_MAX_IMAGE_BYTES=1048576
VISION_MAX_PAYLOAD_BYTES=20971520

# 외부 실호출 전 확인 단계 강제 여부 (기본: true — UI에서 확인 단계를 건너뛰지 않음)
VISION_EXTERNAL_CONFIRM_REQUIRED=true

# === 데이터 경로 ===
DATA_ROOT_PATH=./data
VIDEOS_DIR=./data/videos
FRAMES_DIR=./data/frames
AUDIO_DIR=./data/audio
DB_PATH=./data/app.db
EXPORTS_DIR=./data/exports

# === 리소스 경로 ===
RESOURCES_DIR=./resources
NURI_AREAS_JSON=./resources/nuri_areas.json
KICCE_ITEMS_JSON=./resources/kicce_items.json

# === 분석 파라미터 ===
# 프레임 추출
MAX_FRAMES_PER_VIDEO=30
MAX_FRAMES_PER_SEGMENT=5
BLUR_THRESHOLD=100.0

# 장면 분할
SCENE_DETECTOR=ContentDetector

# 오디오 STT (whisper 모델)
WHISPER_MODEL=base
STT_ENABLED=true

# === 비용 제어 ===
# 비전 API 호출 상한
MAX_API_CALLS_PER_VIDEO=50
MAX_TOKENS_PER_REQUEST=4000

# === 로깅 ===
LOG_LEVEL=INFO
LOG_FILE=./data/app.log

# === 개발 모드 ===
DEBUG_MODE=false

# === 감사 로그 행위자 ===
DEFAULT_ACTOR=teacher_demo
