# .env.example — 필요한 환경변수 샘플
# 실제 사용 시 .env 파일을 생성하고 아래 값들을 교체하세요.
# .env는 Git에 커밋하지 마세요.

# === 비전 LLM API ===
# 다음 중 1개 선택해서 채우세요 (나머지는 주석 처리)

# Google Gemini
# VISION_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI GPT-4o
# VISION_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude
# VISION_PROVIDER=claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === 데이터 경로 ===
DATA_ROOT_PATH=./data
VIDEOS_DIR=./data/videos
FRAMES_DIR=./data/frames
AUDIO_DIR=./data/audio
DB_PATH=./data/app.db
EXPORTS_DIR=./data/exports

# === 리소스 경로 ===
RESOURCES_DIR=./resources
NURI_AREAS_JSON=./resources/nuri_areas.json
KICCE_ITEMS_JSON=./resources/kicce_items.json

# === 분석 파라미터 ===
# 프레임 추출
MAX_FRAMES_PER_VIDEO=30
MAX_FRAMES_PER_SEGMENT=5
BLUR_THRESHOLD=100.0

# 장면 분할
SCENE_DETECTOR=ContentDetector

# 오디오 STT (whisper 모델)
WHISPER_MODEL=base
STT_ENABLED=true

# === 비용 제어 ===
# 비전 API 호출 상한
MAX_API_CALLS_PER_VIDEO=50
MAX_TOKENS_PER_REQUEST=4000

# === 로깅 ===
LOG_LEVEL=INFO
LOG_FILE=./data/app.log

# === 개발 모드 ===
DEBUG_MODE=false

# === 감사 로그 행위자 ===
DEFAULT_ACTOR=teacher_demo
